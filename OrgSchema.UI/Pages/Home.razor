@page "/"
@using System.Net.Http
@using System.Net.Http.Json
@using OrgSchema.UI.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

@if (errorMessage != null)
{
    <div class="alert alert-danger">
        <h4>Hata Oluştu</h4>
        <pre>@errorMessage</pre>
    </div>
}
else if (originalOrgNodes == null || allEmployees == null)
{
    <div class="loading-container">
        <p>Veriler yükleniyor, lütfen bekleyin... (Bu işlem veri büyüklüğüne göre 5-10 saniye sürebilir)</p>
        <p>Durum: @statusMessage</p>
    </div>
}
else
{
    <!-- ORGANİZASYON ŞEMASI SEKMESİ -->
    <div style="display: @(activeTab == "OrgChart" ? "block" : "none")">
        <div class="header-container">
            <h1><span class="purple-text">Kurumsal</span> Organizasyon Şeması</h1>
            <p class="hint">💡 Şemayı farenizle sürükleyebilir ve tekerlek (mouse wheel) ile istediğiniz bölgeye yakınlaşabilirsiniz.</p>
            @if(isFocusedMode)
            {
                <button class="btn btn-secondary mt-2" @onclick="ResetFocus">Tüm Şemayı Göster</button>
            }
        </div>

        <div id="org-wrapper" class="org-chart-wrapper">
            <div id="org-container" class="org-chart-container">
                @foreach (var node in currentOrgNodes)
                {
                    <OrgNode Node="node" Level="1" OnNodeFocused="HandleNodeFocused" />
                }
            </div>
        </div>
    </div>

    <!-- KİME DANIŞABİLİRİM SEKMESİ -->
    <div style="display: @(activeTab == "Consult" ? "block" : "none")">
        
        <div class="consult-columns-wrapper">
            <div class="consult-col">
                <h3 class="col-title">Firma</h3>
                <div class="col-list">
                    @foreach (var firma in GetFirms())
                    {
                        <div class="col-item @(selectedFirm == firma ? "active" : "")" @onclick="() => SelectFirm(firma)">
                            @firma
                        </div>
                    }
                </div>
            </div>

            <div class="consult-col">
                <h3 class="col-title">Departmanlar</h3>
                <div class="col-list">
                    @if (!string.IsNullOrEmpty(selectedFirm))
                    {
                        @foreach (var dept in GetDepartments(selectedFirm))
                        {
                            <div class="col-item @(selectedDept == dept ? "active" : "")" @onclick="() => SelectDept(dept)">
                                @dept
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="consult-col">
                <h3 class="col-title">Birimler</h3>
                <div class="col-list">
                    @if (!string.IsNullOrEmpty(selectedDept))
                    {
                        @foreach (var unit in GetUnits(selectedFirm, selectedDept))
                        {
                            <div class="col-item @(selectedUnit == unit ? "active" : "")" @onclick="() => SelectUnit(unit)">
                                @unit
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(selectedUnit))
        {
            <div class="consult-results">
                <h3>@selectedUnit Birimi Yetkilileri</h3>
                <div class="results-grid">
                    @foreach (var person in GetPeopleInUnit(selectedFirm, selectedDept, selectedUnit))
                    {
                        <div class="person-card">
                            <div class="person-avatar">@GetInitials(person.NameSurname)</div>
                            <div class="person-info">
                                <h4>@person.NameSurname</h4>
                                <span class="p-title">@person.PositionName</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<OrgNodeDto>? originalOrgNodes;
    private List<OrgNodeDto>? currentOrgNodes = new();
    private List<FinalEmployeeDto>? allEmployees;
    private string activeTab = "OrgChart";
    private string? errorMessage;
    private string statusMessage = "API isteği başlatılıyor...";
    private bool isFocusedMode = false;

    private string? selectedFirm;
    private string? selectedDept;
    private string? selectedUnit;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            statusMessage = "Şema verisi çekiliyor (GET /api/orgchart)...";
            StateHasChanged();
            
            var req1 = await Http.GetAsync("/api/orgchart");
            if(!req1.IsSuccessStatusCode) {
                errorMessage = $"OrgChart API hatası: {req1.StatusCode}";
                return;
            }
            originalOrgNodes = await req1.Content.ReadFromJsonAsync<List<OrgNodeDto>>();
            currentOrgNodes = originalOrgNodes;
            
            statusMessage = "Düz liste verisi çekiliyor (GET /api/employees/flat)...";
            StateHasChanged();

            var req2 = await Http.GetAsync("/api/employees/flat");
            if(!req2.IsSuccessStatusCode) {
                errorMessage = $"Employees API hatası: {req2.StatusCode}";
                return;
            }
            allEmployees = await req2.Content.ReadFromJsonAsync<List<FinalEmployeeDto>>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.ToString();
        }
    }

    private void HandleNodeFocused(string targetId)
    {
        if (originalOrgNodes == null) return;
        var path = FindPath(originalOrgNodes, targetId);
        if (path != null && path.Any())
        {
            currentOrgNodes = BuildFocusedTree(path);
            isFocusedMode = true;
            StateHasChanged();
        }
    }

    private void ResetFocus()
    {
        currentOrgNodes = originalOrgNodes;
        isFocusedMode = false;
        StateHasChanged();
    }

    private List<OrgNodeDto>? FindPath(List<OrgNodeDto> nodes, string targetId)
    {
        foreach(var node in nodes) {
            if (node.Id == targetId) return new List<OrgNodeDto> { node };
            var subPath = FindPath(node.Children, targetId);
            if (subPath != null) {
                subPath.Insert(0, node);
                return subPath;
            }
        }
        return null;
    }

    private List<OrgNodeDto> BuildFocusedTree(List<OrgNodeDto> path)
    {
        int startIndex = Math.Max(0, path.Count - 3); 
        
        OrgNodeDto? rootOfFocused = null;
        OrgNodeDto? currentClone = null;
        
        for (int i = startIndex; i < path.Count; i++)
        {
            var original = path[i];
            var clone = new OrgNodeDto 
            {
                Id = original.Id,
                Name = original.Name,
                Type = original.Type,
                Employees = original.Employees,
                Company = original.Company,
                Department = original.Department,
                Unit = original.Unit,
                IsExpanded = true,
                Children = new List<OrgNodeDto>()
            };
            
            if (rootOfFocused == null) {
                rootOfFocused = clone;
                currentClone = clone;
            } else {
                currentClone!.Children.Add(clone);
                currentClone = clone;
            }
        }
        
        var targetNode = path.Last();
        foreach(var child in targetNode.Children)
        {
            var childClone = new OrgNodeDto
            {
                Id = child.Id,
                Name = child.Name,
                Type = child.Type,
                Employees = child.Employees,
                Company = child.Company,
                Department = child.Department,
                Unit = child.Unit,
                IsExpanded = false, 
                Children = child.Children 
            };
            currentClone!.Children.Add(childClone);
        }
        
        return new List<OrgNodeDto> { rootOfFocused! };
    }

    private bool _zoomInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (originalOrgNodes != null && allEmployees != null && !_zoomInitialized && activeTab == "OrgChart")
        {
            _zoomInitialized = true;
            await Task.Delay(200); 
            await JSRuntime.InvokeVoidAsync("orgChartFunctions.initZoomPan", "org-wrapper", "org-container");
        }
    }

    private async Task SwitchTab(string tabName)
    {
        activeTab = tabName;
        StateHasChanged();
        if (tabName == "OrgChart" && originalOrgNodes != null)
        {
            await Task.Delay(100); 
            await JSRuntime.InvokeVoidAsync("orgChartFunctions.initZoomPan", "org-wrapper", "org-container");
        }
    }

    private void SelectFirm(string firm)
    {
        selectedFirm = firm;
        selectedDept = null;
        selectedUnit = null;
    }

    private void SelectDept(string dept)
    {
        selectedDept = dept;
        selectedUnit = null;
    }

    private void SelectUnit(string unit)
    {
        selectedUnit = unit;
    }

    private IEnumerable<string> GetFirms()
    {
        return allEmployees!.Where(x => !string.IsNullOrWhiteSpace(x.CompanyName)).Select(x => x.CompanyName).Distinct().OrderBy(x => x);
    }

    private IEnumerable<string> GetDepartments(string firm)
    {
        return allEmployees!.Where(x => x.CompanyName == firm && !string.IsNullOrWhiteSpace(x.DepartmentName))
                            .Select(x => x.DepartmentName).Distinct().OrderBy(x => x);
    }

    private IEnumerable<string> GetUnits(string firm, string dept)
    {
        return allEmployees!.Where(x => x.CompanyName == firm && x.DepartmentName == dept && !string.IsNullOrWhiteSpace(x.UnitName))
                            .Select(x => x.UnitName).Distinct().OrderBy(x => x);
    }

    private IEnumerable<FinalEmployeeDto> GetPeopleInUnit(string firm, string dept, string unit)
    {
        return allEmployees!.Where(x => x.CompanyName == firm && x.DepartmentName == dept && x.UnitName == unit)
                            .OrderByDescending(x => x.PositionName != null && (x.PositionName.Contains("Müdür") || x.PositionName.Contains("Yönetici")))
                            .ThenBy(x => x.NameSurname);
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}


