@page "/"
@using OrgSchema.UI.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Kanik Şirketler Grubu Portal</PageTitle>

<div class="header-tabs">
    <div class="tab @(activeTab == "OrgChart" ? "active" : "")" @onclick='() => SwitchTab("OrgChart")'>
        <span class="icon">🗂️</span> Organizasyon Şeması
    </div>
    <div class="tab @(activeTab == "Consult" ? "active" : "")" @onclick='() => SwitchTab("Consult")'>
        <span class="icon">❓</span> Kime Danışabilirim
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="loading-container">
        <p style="color: red; max-width: 600px; text-align: center;">@errorMessage</p>
    </div>
}
else if (orgNodes == null || allEmployees == null)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <p>Veriler yükleniyor...</p>
    </div>
}
else if (!orgNodes.Any())
{
    <div class="loading-container">
        <p>Gösterilecek organizasyon verisi bulunamadı.</p>
    </div>
}
else
{
    <!-- ORGANİZASYON ŞEMASI SEKMESİ -->
    <div style="display: @(activeTab == "OrgChart" ? "block" : "none")">
        <div class="header-container">
            <h1><span class="purple-text">Kurumsal</span> Organizasyon Şeması</h1>
            <p class="hint">💡 Şemayı farenizle sürükleyebilir ve tekerlek (mouse wheel) ile istediğiniz bölgeye yakınlaşabilirsiniz.</p>
        </div>

        <div id="org-wrapper" class="org-chart-wrapper">
            <div id="org-container" class="org-chart-container">
                @foreach (var node in orgNodes)
                {
                    <OrgNode Node="node" Level="1" />
                }
            </div>
        </div>
    </div>

    <!-- KİME DANIŞABİLİRİM SEKMESİ -->
    <div style="display: @(activeTab == "Consult" ? "block" : "none")">
        
        <div class="consult-columns-wrapper">
            <!-- 1. Firma Kolonu -->
            <div class="consult-col">
                <h3 class="col-title">Firma</h3>
                <div class="col-list">
                    @foreach (var firma in GetFirms())
                    {
                        <div class="col-item @(selectedFirm == firma ? "active" : "")" @onclick="() => SelectFirm(firma)">
                            @firma
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Departmanlar Kolonu -->
            <div class="consult-col">
                <h3 class="col-title">Departmanlar</h3>
                <div class="col-list">
                    @if (!string.IsNullOrEmpty(selectedFirm))
                    {
                        @foreach (var dept in GetDepartments(selectedFirm))
                        {
                            <div class="col-item @(selectedDept == dept ? "active" : "")" @onclick="() => SelectDept(dept)">
                                @dept
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- 3. Birimler Kolonu -->
            <div class="consult-col">
                <h3 class="col-title">Birimler</h3>
                <div class="col-list">
                    @if (!string.IsNullOrEmpty(selectedDept))
                    {
                        @foreach (var unit in GetUnits(selectedFirm, selectedDept))
                        {
                            <div class="col-item @(selectedUnit == unit ? "active" : "")" @onclick="() => SelectUnit(unit)">
                                @unit
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- 4. Sonuç (Kişiler) Listesi -->
        @if (!string.IsNullOrEmpty(selectedUnit))
        {
            <div class="consult-results">
                <h3>@selectedUnit Birimi Yetkilileri</h3>
                <div class="results-grid">
                    @foreach (var person in GetPeopleInUnit(selectedFirm, selectedDept, selectedUnit))
                    {
                        <div class="person-card">
                            <div class="person-avatar">@GetInitials(person.ENAME)</div>
                            <div class="person-info">
                                <h4>@person.ENAME</h4>
                                <span class="p-title">@person.POSITIONNAME</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<OrgNodeDto>? orgNodes;
    private List<HROrganizationDto>? allEmployees;
    private string activeTab = "OrgChart";
    private string? errorMessage;

    private string? selectedFirm;
    private string? selectedDept;
    private string? selectedUnit;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            // Orijinal hiyerarşik ağaç verisi (OrgChart için)
            orgNodes = await Http.GetFromJsonAsync<List<OrgNodeDto>>("http://localhost:5009/api/orgchart");
            
            // "Kime Danışabilirim" ekranı için düz (flat) listeyi doğrudan yeni API'den çek
            allEmployees = await Http.GetFromJsonAsync<List<HROrganizationDto>>("http://localhost:5009/api/employees/flat");
        }
        catch (Exception ex)
        {
            errorMessage = "API'ye bağlanırken veya veritabanından veri çekerken bir hata oluştu. Hata detayı: " + ex.Message;
            Console.WriteLine(errorMessage);
        }
    }

    private bool _zoomInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // orgNodes null değilse ve daha önce initialize etmediysek, render tamamlanmıştır.
        if (orgNodes != null && !_zoomInitialized && activeTab == "OrgChart")
        {
            _zoomInitialized = true;
            await Task.Delay(200); // DOM'un ekrana tamamen çizilmesi için kısa bir bekleme
            await JSRuntime.InvokeVoidAsync("orgChartFunctions.initZoomPan", "org-wrapper", "org-container");
        }
    }

    private async Task SwitchTab(string tabName)
    {
        activeTab = tabName;
        StateHasChanged();

        // OrgChart'a geri dönerse JS Pan/Zoom'u tekrar başlat (DOM değiştiği için)
        if (tabName == "OrgChart" && orgNodes != null)
        {
            await Task.Delay(100); // DOM render'ı bekle
            await JSRuntime.InvokeVoidAsync("orgChartFunctions.initZoomPan", "org-wrapper", "org-container");
        }
    }

    // --- Kime Danışabilirim Filtreleme Mantığı ---
    private void SelectFirm(string firm)
    {
        selectedFirm = firm;
        selectedDept = null;
        selectedUnit = null;
    }

    private void SelectDept(string dept)
    {
        selectedDept = dept;
        selectedUnit = null;
    }

    private void SelectUnit(string unit)
    {
        selectedUnit = unit;
    }

    private IEnumerable<string> GetFirms()
    {
        return allEmployees!.Where(x => !string.IsNullOrWhiteSpace(x.COMPANYNAME)).Select(x => x.COMPANYNAME).Distinct().OrderBy(x => x);
    }

    private IEnumerable<string> GetDepartments(string firm)
    {
        return allEmployees!.Where(x => x.COMPANYNAME == firm && !string.IsNullOrWhiteSpace(x.DEPARTMENTNAME))
                            .Select(x => x.DEPARTMENTNAME).Distinct().OrderBy(x => x);
    }

    private IEnumerable<string> GetUnits(string firm, string dept)
    {
        // HROrganizationDto'da Unit yok, Profession'u Unit olarak kullanalım veya doğrudan null dönelim
        return allEmployees!.Where(x => x.COMPANYNAME == firm && x.DEPARTMENTNAME == dept && !string.IsNullOrWhiteSpace(x.PROFESSION))
                            .Select(x => x.PROFESSION).Distinct().OrderBy(x => x);
    }

    private IEnumerable<HROrganizationDto> GetPeopleInUnit(string firm, string dept, string unit)
    {
        // Yönetici unvanı geçenler veya yetkili kişiler üste gelsin diye bir sıralama yapılabilir
        return allEmployees!.Where(x => x.COMPANYNAME == firm && x.DEPARTMENTNAME == dept && x.PROFESSION == unit)
                            .OrderByDescending(x => x.POSITIONNAME.Contains("Müdür") || x.POSITIONNAME.Contains("Yönetici"))
                            .ThenBy(x => x.ENAME);
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}
