@using OrgSchema.UI.Models

<div class="org-node level-@Level node-position">
    <div class="card">
        <div class="card-content">
            <span class="title">@Node.Name</span>
            
            @if (Node.Employees.Any())
            {
                <div class="employee-list">
                    @foreach (var emp in Node.Employees)
                    {
                        <div class="employee-item">
                            <span class="name">@emp.NameSurname</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    
    @if (Node.Children.Any())
    {
        var layoutClass = Level >= 2 ? "hanging" : "horizontal";
        <div class="children @layoutClass">
            @foreach (var child in Node.Children)
            {
                <OrgNode Node="child" Level="@(Level + 1)" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public OrgNodeDto Node { get; set; } = new();
    [Parameter] public int Level { get; set; } = 1;
}
